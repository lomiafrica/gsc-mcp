{
  "name": "@lomi./gsc-mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Model Context Protocol server for Google Search Console with typed analytics, inspection, and sitemap tools",
  "type": "module",
  "mcpName": "lomi-gsc",
  "bin": {
    "lomi-gsc-mcp": "./dist/index.js",
    "lomi-gsc-mcp-http": "./dist/http-entry.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http-entry.js",
    "dev": "tsx src/index.ts",
    "dev:http": "GSC_MCP_TRANSPORT=http tsx src/http-entry.ts",
    "auth": "tsx src/index.ts auth",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-config-hints"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "zod": "^4.4.3",
    "@lomi./shared": "file:../../../packages/shared"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "knip": "5.63.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "lomi.",
    "mcp",
    "google-search-console",
    "seo",
    "search-analytics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lomiafrica/gsc-mcp.git"
  }
}
