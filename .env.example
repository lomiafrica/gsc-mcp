# Google credentials (pick one path)
# GSC_OAUTH_CLIENT_FILE=/path/to/oauth-client.json
# GSC_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account.json
# GSC_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Optional: request write scope during OAuth (default: readonly)
# GSC_OAUTH_SCOPE=readonly

# Enable mutation tools (sitemap submit/delete, property add/remove)
# GSC_ENABLE_WRITES=false

# HTTP transport
# GSC_MCP_TRANSPORT=stdio
# GSC_MCP_HTTP_HOST=0.0.0.0
# GSC_MCP_HTTP_PORT=3344
# GSC_MCP_HTTP_PATH=/mcp
# GSC_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# GSC_MCP_ALLOWED_ORIGINS=http://localhost:3000
# GSC_MCP_CLIENT_BEARER_TOKEN=replace-with-random-secret
# GSC_MCP_RATE_LIMIT_RPM=120
# GSC_MCP_MAX_BODY_BYTES=1048576
# GSC_MCP_MAX_RESULT_ROWS=5000
